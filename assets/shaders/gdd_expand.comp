#version 450
/*
 * SPACE GL - GDD compute pass 2: MESH ALLOCATION / EXPANSION.
 * Copyright (C) 2026 Nicola Taibi
 * License: GPL-3.0-or-later
 *
 * Consumes the gdd_cull index list (culling is a SEPARATE pass). Each
 * visible instance is expanded into the device-local vertex SSBO with
 * a capacity-guarded atomic reservation (drop when full). One dispatch
 * per group; the dispatch size is the INPUT count (the visible count
 * is only known through the counters), so the entry guards on it.
 */
#include "gdd_common.glsl"

/* one workgroup per instance: its invocations share the expansion of the mesh (gdd_ops.glsl) */
layout(local_size_x = 64) in;

shared uint s_base;
shared uint s_ok;

layout(binding = 0) buffer GddInstB     { GddInstance inst[]; } gdd_insts;
layout(binding = 1) buffer GddVisB      { uint          idx[]; } gdd_vis;
layout(binding = 2) buffer GddCntB      { GddCounts     c; }     gdd_counts;
layout(binding = 3) buffer GddVtxB      { GddVertex     v[]; }   gdd_verts;
layout(binding = 4) buffer GddFeedbackB { GddFrameFeedback feedback; } gdd_feedback;

#include "gdd_ops.glsl"

/* Vertex count of a mesh (the constants of gdd_common.glsl); unknown = the box. */
uint gdd_vc_for(int mesh) {
    switch (mesh) {
        case GDD_MESH_POINT:     return GDD_VC_POINT;
        case GDD_MESH_SPHERE:    return GDD_VC_SPHERE;
        case GDD_MESH_SPHERE_HI: return GDD_VC_SPHERE_HI;
        case GDD_MESH_BOX3:      return GDD_VC_BOX3;
        case GDD_MESH_DISC:      return GDD_VC_DISC;
        case GDD_MESH_BOX:       return GDD_VC_BOX;
        case GDD_MESH_PYRAMID:   return GDD_VC_PYRAMID;
        case GDD_MESH_OCTA:      return GDD_VC_OCTA;
        case GDD_MESH_RING:      return GDD_VC_RING;
        case GDD_MESH_LINE:      return GDD_VC_LINE;
        case GDD_MESH_CIRCLE:    return GDD_VC_CIRCLE;
        case GDD_MESH_ARC:       return GDD_VC_ARC;
        case GDD_MESH_BOOM:      return GDD_VC_BOOM;
        case GDD_MESH_BOXWIRE:   return GDD_VC_BOXWIRE;
        default:                 return GDD_VC_BOX;
    }
}

/* Dispatched with one workgroup per instance slot (the slot count is an upper bound of the
 * visible count, only known on the GPU): the workgroups past it, and the ones of the other
 * pass (opaque / additive), leave at once. Every early return below depends on values the
 * whole workgroup shares, so the barrier is reached by all invocations or by none. */
void main() {
    uint i = gl_WorkGroupID.x;
    uint lim = (pc.group == 1u) ? gdd_counts.c.map_vis : gdd_counts.c.dyn_vis;
    if (i >= lim) return;

    GddInstance it = gdd_insts.inst[gdd_vis.idx[i]];

    bool is_add = gdd_additive(it);
    if (pc.pad == 0u && is_add) return;
    if (pc.pad == 1u && !is_add) return;

    int mesh = int(it.a.w + 0.5);
    uint base = 0u;
    if (gl_LocalInvocationID.x == 0u) {
        s_ok = gdd_reserve(it, gdd_vc_for(mesh), base) ? 1u : 0u;
        s_base = base;
    }
    memoryBarrierShared();
    barrier();
    if (s_ok == 0u) return;
    base = s_base;

    gdd_lane  = gl_LocalInvocationID.x;
    gdd_lanes = gl_WorkGroupSize.x;

    switch (mesh) {
        /* the meshes of many independent pieces: all the invocations work */
        case GDD_MESH_SPHERE:    gdd_expand_sphere(base, it); break;
        case GDD_MESH_SPHERE_HI: gdd_expand_sphere_hi(base, it); break;
        case GDD_MESH_RING:      gdd_expand_ring(base, it); break;
        case GDD_MESH_CIRCLE:    gdd_expand_circle(base, it); break;
        case GDD_MESH_ARC:       gdd_expand_arc(base, it); break;
        case GDD_MESH_BOXWIRE:   gdd_expand_boxwire(base, it); break;
        case GDD_MESH_BOOM:      gdd_expand_boom(base, it); break;
        default:
            /* small meshes (at most 36 vertices): invocation 0 writes them all */
            if (gdd_lane != 0u) return;
            gdd_lanes = 1u;
            switch (mesh) {
                case GDD_MESH_POINT:   gdd_expand_point(base, it); break;
                case GDD_MESH_BOX3:    gdd_expand_box3(base, it); break;
                case GDD_MESH_DISC:    gdd_expand_disc(base, it); break;
                case GDD_MESH_BOX:     gdd_expand_box(base, it); break;
                case GDD_MESH_PYRAMID: gdd_expand_pyramid(base, it); break;
                case GDD_MESH_OCTA:    gdd_expand_octa(base, it); break;
                case GDD_MESH_LINE:    gdd_expand_line(base, it); break;
                default:               gdd_expand_box(base, it); break;
            }
            break;
    }
}
