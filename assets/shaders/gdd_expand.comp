#version 450
/*
 * SPACE GL - GDD compute pass 2: MESH ALLOCATION / EXPANSION.
 * Copyright (C) 2026 Nicola Taibi
 * License: GPL-3.0-or-later
 *
 * Consumes the gdd_cull index list (culling is a SEPARATE pass). Each
 * visible instance is expanded into the device-local vertex SSBO with
 * a capacity-guarded atomic reservation (drop when full). One dispatch
 * per group; the dispatch size is the INPUT count (the visible count
 * is only known through the counters), so the entry guards on it.
 */
#include "gdd_common.glsl"

layout(local_size_x = 256) in;

layout(binding = 0) buffer GddInstB  { GddInstance inst[]; } gdd_insts;
layout(binding = 1) buffer GddVisB   { uint          idx[]; } gdd_vis;
layout(binding = 2) buffer GddCntB   { GddCounts     c; }     gdd_counts;
layout(binding = 3) buffer GddVtxB   { GddVertex     v[]; }   gdd_verts;

#include "gdd_ops.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lim = (pc.group == 1u) ? gdd_counts.c.map_vis : gdd_counts.c.dyn_vis;
    if (i >= lim) return;

    GddInstance it = gdd_insts.inst[gdd_vis.idx[i]];
    
    // Filtro pass: pc.pad == 0 -> solo opachi, pc.pad == 1 -> solo additivi
    bool is_add = gdd_additive(it);
    if (pc.pad == 0u && is_add) return;
    if (pc.pad == 1u && !is_add) return;

    int mesh = int(it.a.w + 0.5);
    uint base;
    switch (mesh) {
        case GDD_MESH_POINT:   if (!gdd_reserve(it, GDD_VC_POINT, base)) return; gdd_expand_point(base, it); break;
        case GDD_MESH_SPHERE:  if (!gdd_reserve(it, GDD_VC_SPHERE, base)) return; gdd_expand_sphere(base, it); break;
        case GDD_MESH_BOX:     if (!gdd_reserve(it, GDD_VC_BOX, base)) return; gdd_expand_box(base, it); break;
        case GDD_MESH_PYRAMID: if (!gdd_reserve(it, GDD_VC_PYRAMID, base)) return; gdd_expand_pyramid(base, it); break;
        case GDD_MESH_OCTA:    if (!gdd_reserve(it, GDD_VC_OCTA, base)) return; gdd_expand_octa(base, it); break;
        case GDD_MESH_RING:    if (!gdd_reserve(it, GDD_VC_RING, base)) return; gdd_expand_ring(base, it); break;
        case GDD_MESH_LINE:    if (!gdd_reserve(it, GDD_VC_LINE, base)) return; gdd_expand_line(base, it); break;
        case GDD_MESH_CIRCLE:  if (!gdd_reserve(it, GDD_VC_CIRCLE, base)) return; gdd_expand_circle(base, it); break;
        case GDD_MESH_ARC:     if (!gdd_reserve(it, GDD_VC_ARC, base)) return; gdd_expand_arc(base, it); break;
        case GDD_MESH_BOOM:    if (!gdd_reserve(it, GDD_VC_BOOM, base)) return; gdd_expand_boom(base, it); break;
        case GDD_MESH_BOXWIRE: if (!gdd_reserve(it, GDD_VC_BOXWIRE, base)) return; gdd_expand_boxwire(base, it); break;
        default:               if (!gdd_reserve(it, GDD_VC_BOX, base)) return; gdd_expand_box(base, it); break;
    }
}
